{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "velite build --clean && next build",
    "ci": "velite build --clean && pnpm run static-analysis && pnpm run test && next build",
    "dev": "next dev --turbopack",
    "dev:email": "email dev --dir src/features/emails/templates --port 4000",
    "format": "biome format --write && prettier --write \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome format && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "lint": "biome check --write --error-on-warnings",
    "lint:check": "biome check --error-on-warnings",
    "prepare": "husky",
    "security:audit": "pnpm audit --audit-level=moderate",
    "sonar:clean": "tsx scripts/sonar-clean.ts",
    "sonar:scan": "tsx scripts/sonar-scan.ts",
    "start": "next start",
    "static-analysis": "biome ci --error-on-warnings && prettier --check \"**/*.{md,mdx,yaml,yml}\" && pnpm run type-check",
    "test": "vitest run",
    "test:e2e": "playwright test --project=phone --project=desktop",
    "test:screenshots": "playwright test --project=screenshots",
    "test:watch": "vitest",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next-safe-action/adapter-react-hook-form": "^2.0.6",
    "@next/mdx": "^16.4.1",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.4.0",
    "@react-email/components": "^1.0.12",
    "@shikijs/rehype": "^4.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.4.1",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.0",
    "react-email": "6.11.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "velite": "^0.4.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=11.6.0"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27"
}
